{
  "name": "lessonique",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "prepare:monaco": "node scripts/sync-monaco-assets.mjs",
    "postinstall": "node scripts/sync-monaco-assets.mjs",
    "predev": "node scripts/sync-monaco-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-monaco-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:production": "playwright test --project=desktop-chromium",
    "verify:release-boundaries": "node scripts/verify-release-boundaries.mjs",
    "verify:release-performance": "node scripts/verify-release-performance.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "acorn": "^8.18.0",
    "acorn-loose": "^8.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "monaco-editor": "^0.56.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "parse5": "^8.0.1",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
